{
  "name": "taxios-v0-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "packageExtensions": {
      "@hookform/resolvers@5.4.0": {
        "peerDependencies": {
          "zod": "^3.25.0 || ^4.0.0"
        }
      }
    }
  },
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev": "turbo dev",
    "lint": "pnpm exec biome lint .",
    "registry:build": "pnpm --filter @taxios-v2/taxios-v0-registry build",
    "registry:check-types": "pnpm --filter @taxios-v2/taxios-v0-registry check-types",
    "registry:prebuild": "pnpm --filter @taxios-v2/taxios-v0-registry prebuild"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.2",
    "playwright": "^1.60.0",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
